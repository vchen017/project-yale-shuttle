{
 "about": "Yale buildings for the trip search (issue #98). Official names and abbreviations come from the two sources below, retrieved 2026-11-16; coordinates and street addresses come from OpenStreetMap. To add a building, add an entry with its abbreviation, official name, street, lat and lon. Optional: also_known_as lists other names for it (OpenStreetMap's name when it differs from the official one), and short_names lists a bare word riders type for it when several buildings share that word. A building with short_names comes first for exactly that word, ahead of abbreviations: 'sterling' is Sterling Memorial Library and 'bass' is Bass Library, added after the review of PR #101 so that Find my bus plans a trip to the building most people mean.",
 "sources": {
  "college": {
   "title": "Yale College Programs of Study 2026-2027, Building Abbreviations",
   "url": "https://catalog.yale.edu/ycps/building-abbreviations/",
   "used_for": "all 95 entries except the 15 address-style ones such as '35 Broadway', which Photon already finds"
  },
  "medicine": {
   "title": "Yale School of Medicine, A to Z index: Abbreviations",
   "url": "https://medicine.yale.edu/about/a-to-z-index/abbreviations/",
   "used_for": "entries whose name ends in Hall, Building, Pavilion, Library, Laboratory or Hospital and that the Yale College list doesn't have"
  },
  "coordinates": {
   "title": "OpenStreetMap contributors (ODbL), read through the Overpass API on 2026-11-16",
   "url": "https://www.openstreetmap.org/copyright",
   "used_for": "lat, lon and street. A building is included only if an OpenStreetMap object within 2 km of campus has a name that fits its official name; also_known_as is OpenStreetMap's name when it differs from the official one"
  }
 },
 "left_out": {
  "no safe coordinates": [
   "Durfee Hall (D)",
